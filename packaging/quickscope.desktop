[Desktop Entry]
Type=Application
Name=quickscope
GenericName=Screenshot annotator
Comment=Open the last screenshot in the quickscope editor
Exec=quickscope open-last
Icon=camera-photo
Terminal=false
Categories=Graphics;Utility;
Keywords=screenshot;annotate;capture;
StartupNotify=false
Actions=region;screen;

[Desktop Action region]
Name=Capture a region
Exec=quickscope capture region

[Desktop Action screen]
Name=Capture all screens
Exec=quickscope capture screen
