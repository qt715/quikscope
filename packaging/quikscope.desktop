[Desktop Entry]
Type=Application
Name=quikscope
GenericName=Screenshot annotator
Comment=Open the last screenshot in the quikscope editor
Exec=quikscope open-last
Icon=quikscope
Terminal=false
Categories=Graphics;Utility;
Keywords=screenshot;annotate;capture;
StartupNotify=false
Actions=region;screen;

[Desktop Action region]
Name=Capture a region
Exec=quikscope capture region

[Desktop Action screen]
Name=Capture all screens
Exec=quikscope capture screen
